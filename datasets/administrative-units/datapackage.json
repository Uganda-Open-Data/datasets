{
  "name": "administrative-units",
  "title": "Administrative units of Uganda",
  "description": "The administrative hierarchy of Uganda from regions down to villages: 4 regions, 15 sub-regions, districts (including cities and municipal councils), counties, sub-counties, parishes and villages, with the codes used by government and a crosswalk to ISO 3166-2, OCHA COD-AB P-codes, Wikidata, OpenStreetMap and GeoNames.",
  "version": "0.2",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "path": "https://creativecommons.org/licenses/by/4.0/",
      "title": "Creative Commons Attribution 4.0 International"
    }
  ],
  "sources": [
    {
      "title": "Uganda Bureau of Statistics (UBOS)",
      "path": "https://www.ubos.org",
      "date": "2025-04-10"
    }
  ],
  "portal": {
    "theme": "Boundaries and locations",
    "keywords": [
      "Uganda",
      "administrative units",
      "gazetteer",
      "districts",
      "parishes",
      "villages",
      "ISO 3166-2"
    ],
    "spatial": "Uganda",
    "knownIssues": [
      "Codes (ubosCode) are only unique within their parent unit, except for districts. Use the numeric id as the identifier.",
      "Cities and municipal councils appear as separate units at district level.",
      "UBOS district codes are not ISO 3166-2 codes; the ISO code is published separately in the identifiers attribute.",
      "COD-AB P-codes are matched by name against the 2020 COD-AB boundaries. Cities, divisions and units created or reorganised since 2020 may have no P-code.",
      "70 villages have no household code prefix (hh_code_prefix). Run \"php artisan opendata:validate\" for the current list of data quality warnings.",
      "The change history starts on 2026-11-08; earlier boundary changes (such as the 2020 cities) are not recorded, and validity dates are empty unless known."
    ],
    "changelog": [
      {
        "date": "2026-11-08",
        "note": "Validity dates and a change history for every unit; retired units drop out of lists but stay available. Crosswalk to COD-AB P-codes, Wikidata, OpenStreetMap and GeoNames."
      },
      {
        "date": "2026-11-08",
        "note": "API v1: stable ids, full ancestor path, ISO 3166-2 crosswalk, bulk downloads."
      },
      {
        "date": "2025-04-10",
        "note": "First publication."
      }
    ]
  },
  "resources": [
    {
      "name": "regions",
      "title": "Regions",
      "description": "All Regions with the ids of their ancestors.",
      "path": "data/regions.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "id",
            "type": "integer",
            "description": "Region id"
          },
          {
            "name": "name",
            "type": "string",
            "description": "Name"
          },
          {
            "name": "sub_name",
            "type": "string",
            "description": "Alternate name"
          },
          {
            "name": "code",
            "type": "string",
            "description": "Code as published by government"
          },
          {
            "name": "valid_from",
            "type": "date",
            "description": "When the unit came into force, where known"
          },
          {
            "name": "valid_to",
            "type": "date",
            "description": "When the unit was abolished, merged or split; empty while it is current"
          },
